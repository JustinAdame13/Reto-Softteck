PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/pelones
DB_USERNAME=postgres
DB_PASSWORD=tu_password_de_postgres
SHOW_SQL=false

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- IA (opcional) ----------
# Pon la llave SOLO de los proveedores que vayas a usar. El que no tenga llave
# no aparece en GET /configuracion/ia/proveedores y el switch lo rechaza.
# El modelo es opcional: vacio = el por defecto del codigo.
# Que proveedor se usa se elige en caliente con PATCH /api/v1/configuracion/ia
IA_ANTHROPIC_API_KEY=
IA_ANTHROPIC_MODELO=

IA_OPENAI_API_KEY=
IA_OPENAI_MODELO=

IA_GEMINI_API_KEY=
IA_GEMINI_MODELO=

IA_TIMEOUT=30

# ---------- Motor de prediccion ----------
# interno = algoritmo BASE en Java. externo = POST {MOTOR_URL}/predecir (ej. Python/FastAPI)
MOTOR_TIPO=interno
MOTOR_URL=http://localhost:8000
